# Optional per-machine environment for pango-mcp.
# Copy to pango-mcp.env or point PANGO_MCP_ENV_FILE at your own file.

# PDS shells. System environment variables with the same names take precedence.
PANGO_MCP_PDS_2022=D:\pango\PDS_2022.2-SP4.2-ads\bin\pds_shell.exe
PANGO_MCP_PDS_2025=D:\pango\PDS_2025.2-SP1-ads\bin\pds_shell.exe

# Pango license file. Required for real pds_shell compile/synthesis.
PANGO_LICENSE_FILE=D:\licenses\pango.lic

# ModelSim/Questa install root (the directory containing win64/ + modelsim.ini).
# System env vars PANGO_MCP_MODELSIM_HOME / MODELSIM_HOME / MODEL_TECH override.
PANGO_MCP_MODELSIM_HOME=D:\modeltech64_2020.4

# ModelSim/Questa license file (FlexLM/Mentor .dat/.txt with vsim/vlog/vcom
# features). REQUIRED for real fpga_msim_* simulation: an MCP server is spawned
# over stdio with only a safe env subset, so it does NOT inherit your shell's
# LM_LICENSE_FILE/MGLS_LICENSE_FILE. This value is injected into both for the
# vlog/vcom/vsim children. (Equivalently set config.modelsimLicenseFile.)
PANGO_MCP_MODELSIM_LICENSE=D:\licenses\modelsim.lic

# JTAG server ports used by cdt_js/cdt_cfg.
# PDS 2025.2 is the primary path; keep it away from any old 2022 server.
PANGO_MCP_CDT_PORT_2025=65425
PANGO_MCP_CDT_PORT=65420

# Single-FPGA boards should keep this at 1. Increase only for explicit
# multi-device JTAG chains; probing invalid indexes can dirty a cdt_cfg session.
PANGO_MCP_SCAN_MAX_DEVICES=1

# Wait for cdt_js to open its TCP port after spawning.
PANGO_MCP_CDT_STARTUP_TIMEOUT_MS=10000

# Guarded flash will retry its internal safety scan on transient CDT failures.
# Plain fpga_pds_scan stays single-shot so it remains useful for diagnosis.
PANGO_MCP_FLASH_SCAN_RETRIES=1
PANGO_MCP_FLASH_SCAN_RETRY_DELAY_MS=1500

# Optional personal verified-asset vault. Defaults to ~/.pango-mcp/knowledge-vault
# (home-scoped, so a standalone install never writes outside your checkout).
# Point it at a tracked directory to keep the vault under version control.
# PANGO_MCP_KNOWLEDGE_VAULT=D:\fpga\knowledge-vault

# Optional semantic retrieval layer (fpga_primitive_lookup / fpga_ip_lookup /
# fpga_doc_search). OpenAI-compatible embeddings; the corpus is embedded once
# via `pnpm knowledge:embed` and cached on disk, so queries cost one tiny call.
# Leave unset to use zero-cost keyword retrieval (default). Example: DashScope.
# PANGO_MCP_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PANGO_MCP_EMBED_MODEL=text-embedding-v3
# PANGO_MCP_EMBED_API_KEY=sk-...        # falls back to OPENAI_API_KEY
# PANGO_MCP_EMBED_BATCH=10              # inputs per request (provider-dependent)
# PANGO_MCP_EMBED_DIM=1024             # optional requested dimension

# Free-form Tcl for fpga_cdt. Off by default: Tcl can build a command name at run
# time (`set a cfg_; set b program; $a$b`), which the device-write gate cannot
# see, so commands[] takes one literal command per entry instead. Set this only
# if you need a raw script (e.g. the {{PORT}} placeholder) and accept that the
# confirm + IDCODE gate cannot analyse it.
# PANGO_MCP_ALLOW_RAW_TCL=1

# Connect to an SSH host WITHOUT verifying its host key. Off by default, and a
# host with no hostKeyFingerprint refuses to connect rather than connecting
# unverified. Only for a network where you accept the impersonation risk.
# PANGO_MCP_SSH_INSECURE=1
